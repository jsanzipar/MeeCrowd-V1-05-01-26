{
  "expo": {
    "name": "MeeCrowd",
    "slug": "meecrowd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "meecrowd",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A12"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.meecrowd.app",
      "infoPlist": {
        "NSCameraUsageDescription": "MeeCrowd needs camera access to take profile photos",
        "NSPhotoLibraryUsageDescription": "MeeCrowd needs photo library access to set profile pictures"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0A12"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.meecrowd.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
